<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="40dp"
    android:gravity="center"
    tools:context=".HomeFragment">

    <!-- Logo e Ícono de Refresh -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp">

        <ImageView
            android:id="@+id/ivLogoHome"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/img1776803538603"
            android:contentDescription="Logo" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#FF008746"
            android:contentDescription="Actualizar"
            android:scaleType="fitCenter"
            android:padding="8dp"/>
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressBarHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="visible" />

    <ScrollView
        android:id="@+id/layoutContentHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Hola, [Nombre de Usuario]"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"/>

            <LinearLayout
                android:id="@+id/layoutSinMedidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vincula tu medidor para comenzar"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ID del Medidor"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIdMedidor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnConectarMedidor"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Conectar"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutConMedidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone">

                <!-- Estado del Beneficio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu balance energético es:"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary"/>

                <TextView
                    android:id="@+id/tvEstadoBeneficio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="BENEFICIO REGULAR"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"/>

                <TextView
                    android:id="@+id/tvModoActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="(-CONSUMO-)" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lectura Actual"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="16dp"/>

                        <!-- Sección Eléctrica -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Parámetros Eléctricos"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginBottom="8dp"/>

                        <!-- Voltaje -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Voltaje:"
                                android:textSize="14sp"
                                android:textColor="?android:attr/textColorSecondary"/>

                            <TextView
                                android:id="@+id/tvVoltaje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="127.5 V"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>

                        <!-- Corriente -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Corriente:"
                                android:textSize="14sp"
                                android:textColor="?android:attr/textColorSecondary"/>

                            <TextView
                                android:id="@+id/tvCorriente"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="8.3 A"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>

                        <!-- Separador -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:layout_marginBottom="12dp"/>

                        <!-- Sección Energía -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Flujo de Energía"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginBottom="8dp"/>

                        <!-- Consumo Actual -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Consumo:"
                                android:textSize="14sp"
                                android:textColor="?android:attr/textColorSecondary"/>

                            <TextView
                                android:id="@+id/tvConsumoActual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="1.25 kWh"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF5722"/>
                        </LinearLayout>

                        <!-- Inyección Actual -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Inyección:"
                                android:textSize="14sp"
                                android:textColor="?android:attr/textColorSecondary"/>

                            <TextView
                                android:id="@+id/tvInyeccionActual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="0.85 kWh"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#388E3C"/>
                        </LinearLayout>

                        <!-- Separador -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:layout_marginBottom="12dp"/>

                        <!-- Timestamp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:id="@+id/tvTimestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Última actualización: 14:23:45"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary"/>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>